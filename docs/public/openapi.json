{
  "openapi": "3.1.0",
  "info": {
    "title": "Pay in/out Toquea API",
    "description": "API para iniciar procesos de payout y payin para la plataforma de toquea",
    "version": "0.1.0"
  },
  "tags": [
    {
      "name": "Payin",
      "description": "Endpoints diseñados para iniciar los flujos de recaudación de dinero"
    },
    {
      "name": "Payout",
      "description": "Endpoints diseñados para iniciar los flujos de distribución de dinero"
    }
  ],
  "paths": {
    "/payment/payout": {
      "post": {
        "parameters": [
          {
            "name": "x-merchant-id",
            "in": "header",
            "description": "Merchant identifier",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "summary": "Create a new payout",
        "description": "Creates a new payout based on the provided request data.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePayoutRequestDto",
                "example": {
                  "customId": "new-identifier",
                  "amount": 100000,
                  "currency": "PEN",
                  "beneficiary": {
                    "name": "Sergio",
                    "surname": "test",
                    "documentType": 1,
                    "documentNumber": "12345678",
                    "emailAddress": "sergio.test@dispostable.com"
                  },
                  "destination": {
                    "bank": "002",
                    "accountType": "1",
                    "cci": "00243000584290204477"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Payout successfully created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/CreateMonnetPayoutResponseDto"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Payout"
        ]
      }
    },
    "/payment/payout/{id}": {
      "get": {
        "summary": "Get payout by ID",
        "description": "Retrieves a payout by its unique identifier.",
        "parameters": [
          {
            "name": "x-merchant-id",
            "in": "header",
            "description": "Merchant identifier",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "description": "Unique identifier of the payout",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Payout successfully retrieved.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "data": {
                          "$ref": "#/components/schemas/GetPayoutByIdResponseDto"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "tags": [
          "Payout"
        ]
      }
    }
  },
  "webhooks": {
    "/payment/payout/webhook": {
      "post": {
        "summary": "Webhook to update the payment status",
        "description": "This endpoint receives a webhook with payment information and updates its status in the database.",
        "parameters": [
          {
            "name": "verification",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookRequestBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "success"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Payout"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "BeneficiaryDto": {
        "type": "object",
        "required": [
          "name",
          "surname",
          "documentType",
          "documentNumber",
          "emailAddress"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "surname": {
            "type": "string"
          },
          "documentType": {
            "type": "string"
          },
          "documentNumber": {
            "type": "string"
          },
          "emailAddress": {
            "type": "string"
          }
        }
      },
      "CreateMonnetPayoutResponseDto": {
        "type": "object",
        "properties": {
          "payout": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Payout"
              },
              {
                "type": "null"
              }
            ]
          },
          "output": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Output"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "CreatePayoutRequestDto": {
        "type": "object",
        "required": [
          "currency",
          "beneficiary",
          "destination"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "beneficiary": {
            "$ref": "#/components/schemas/BeneficiaryDto"
          },
          "destination": {
            "$ref": "#/components/schemas/DestinationDto"
          }
        }
      },
      "DestinationDto": {
        "type": "object",
        "required": [
          "bank",
          "accountType",
          "cci"
        ],
        "properties": {
          "bank": {
            "type": "string"
          },
          "accountType": {
            "type": "string"
          },
          "cci": {
            "type": "string"
          }
        }
      },
      "GetPayoutByIdResponseDto": {
        "type": "object",
        "required": [
          "id",
          "orderId",
          "currency",
          "status",
          "createdAt",
          "beneficiary",
          "destination",
          "monnetPayoutId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/PayoutStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "beneficiary": {
            "$ref": "#/components/schemas/BeneficiaryDto"
          },
          "destination": {
            "$ref": "#/components/schemas/DestinationDto"
          },
          "monnetPayoutId": {
            "type": "string"
          }
        }
      },
      "Output": {
        "type": "object",
        "properties": {
          "stage": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "statusChangeDateTime": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Payout": {
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "country": {
            "type": [
              "string",
              "null"
            ]
          },
          "amount": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "orderId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PayoutStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "SUCCESS",
          "REJECTED"
        ]
      },
      "AddressDto": {
        "type": "object",
        "properties": {
          "street": {
            "type": [
              "string",
              "null"
            ]
          },
          "houseNumber": {
            "type": [
              "string",
              "null"
            ]
          },
          "additionalInfo": {
            "type": [
              "string",
              "null"
            ]
          },
          "city": {
            "type": [
              "string",
              "null"
            ]
          },
          "province": {
            "type": [
              "string",
              "null"
            ]
          },
          "country": {
            "type": [
              "string",
              "null"
            ]
          },
          "zipCode": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "BankAccountDto": {
        "type": "object",
        "required": [
          "bankCode",
          "accountType",
          "cci"
        ],
        "properties": {
          "bankCode": {
            "type": "string"
          },
          "accountType": {
            "type": "string"
          },
          "cci": {
            "type": "string"
          },
          "clabe": {
            "type": [
              "string",
              "null"
            ]
          },
          "cbu": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AddressDto"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "CreateMonnetPayoutRequestDto": {
        "type": "object",
        "required": [
          "country",
          "currency",
          "orderId",
          "beneficiary",
          "destination"
        ],
        "properties": {
          "country": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "format": "int32"
          },
          "currency": {
            "type": "string"
          },
          "orderId": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "beneficiary": {
            "$ref": "#/components/schemas/BeneficiaryDto"
          },
          "destination": {
            "$ref": "#/components/schemas/DestinationDto"
          },
          "subMerchantInfo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SubMerchantInfoDto"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "DocumentDto": {
        "type": "object",
        "required": [
          "number"
        ],
        "properties": {
          "type": {
            "type": "integer",
            "format": "int32"
          },
          "number": {
            "type": "string"
          }
        }
      },
      "SubMerchantInfoDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ApiResponse": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "data": {}
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "MonnetPayoutStage": {
        "type": "string",
        "enum": [
          "SUCCESS",
          "REJECTED"
        ]
      },
      "MonnetPayoutStatus": {
        "type": "string",
        "enum": [
          "PROCESSED",
          "REJECTED_BANK",
          "BUSINESS_ERROR",
          "NO_BALANCE",
          "REVERSED"
        ]
      },
      "WebhookRequestBody": {
        "type": "object",
        "required": [
          "payout",
          "output"
        ],
        "properties": {
          "payout": {
            "$ref": "#/components/schemas/Payout"
          },
          "output": {
            "$ref": "#/components/schemas/Output"
          },
          "errors": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
