{
  "openapi": "3.1.0",
  "info": {
    "title": "Pay in/out Toquea API",
    "description": "API para iniciar procesos de payout y payin para la plataforma de toquea",
    "version": "0.1.0"
  },
  "tags": [
    {
      "name": "Payin",
      "description": "Endpoints diseñados para iniciar los flujos de recaudación de dinero"
    },
    {
      "name": "Payout",
      "description": "Endpoints diseñados para iniciar los flujos de distribución de dinero"
    }
  ],
  "paths": {
    "/payout": {
      "post": {
        "tags": [
          "Payout"
        ],
        "summary": "Crea solicitud de pago",
        "operationId": "createPayout",
        "requestBody": {
          "required": true,
          "description": "Descripción de la solicitud de pago",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PayoutRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Solicitud iniciada con exito",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error en la solicitud",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Invalid input"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/payout/{id}": {
      "get": {
        "tags": [
          "Payout"
        ],
        "summary": "Obtiener detalle de una Payout",
        "operationId": "getPayout",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identificador único del payout",
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle del payout encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "abc123"
                    },
                    "customId": {
                      "type": ["string", "null"],
                      "example": "123456789"
                    },
                    "state": {
                      "type": "string",
                      "enum": ["PENDING","SUCCESS","REJECTED"],
                      "example": "PENDING"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autorizado: token inválido o acceso a recurso no permitido",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Unauthorized"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No se encontró la solicitud de payout",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Payout not found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "PayoutRequest": {
        "type": "object",
        "required": [
          "country",
          "amount",
          "currency",
          "customId",
          "beneficiary"
        ],
        "properties": {
          "country": {
            "type": "string",
            "maxLength": 2,
            "example": "PE"
          },
          "amount": {
            "type": "number",
            "format": "float",
            "example": 100.50,
            "description": "Monto a retirar dependiendo de la moneda puede o no tener decimales"
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "example": "PEN",
            "enum": ["PEN","USD"],
            "description": "Código de la moneda en la que deseo hacer el retiro"
          },
          "description": {
            "type": "string",
            "maxLength": 255,
            "description": "Texto libre para agregar datos a la solicitud en formato de texto",
            "example": "Pago por servicio"
          },
          "customId": {
            "type": "string",
            "maxLength": 255,
            "description": "Código de operación definido por quien integre a toquea como parner, este dato puede ser nulo y se recomienda que sea único por operación",
            "example": "123456789"
          },
          "beneficiary": {
            "$ref": "#/components/schemas/BeneficiaryPayout"
          }
        }
      },
      "BeneficiaryPayout": {
        "type": "object",
        "description": "Datos referidos al beneficiaro final del deposito",
        "required": [
          "customId",
          "name",
          "lastName",
          "document",
          "destinationAccount"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 150,
            "example": "Juan"
          },
          "lastName": {
            "type": "string",
            "maxLength": 150,
            "example": "Pérez"
          },
          "email": {
            "type": "string",
            "maxLength": 200,
            "example": "juan.perez@example.com"
          },
          "document": {
            "$ref": "#/components/schemas/IdentificationDocument"
          },
          "destinationAccount": {
            "$ref": "#/components/schemas/DestinationAccount"
          }
        }
      },
      "IdentificationDocument": {
        "type": "object",
        "description": "Documentos del usuario",
        "required": [
          "type",
          "number"
        ],
        "properties": {
          "type": {
            "type": "string",
            "example": "pe-dni"
          },
          "number": {
            "type": "string",
            "example": "12345678"
          }
        }
      },
      "DestinationAccount": {
        "type": "object",
        "description": "Información sobre el destino final del dinero, puede ser una cuenta bancaria o billetera digital",
        "required": [
          "bank",
          "accountType",
          "accountNumber"
        ],
        "properties": {
          "bank": {
            "$ref": "#/components/schemas/BankCode"
          },
          "accountType": {
            "$ref": "#/components/schemas/AccountType"
          },
          "accountNumber": {
            "type": "string",
            "example": "12345678901234567890"
          }
        }
      },
      "AccountType": {
        "type": "string",
        "enum": [
          "CurrentAccount",
          "SavingsAccount",
          "CellphoneNumber"
        ]
      },
      "BankCode": {
        "type": "string",
        "enum": [
          "PE-BBVA",
          "PE-BCP",
          "PE-INTER",
          "PE-SCOTIA",
          "PE-COMERCIO",
          "PE-BANBIF",
          "PE-PICHINCHA",
          "PE-CITI",
          "PE-GNB",
          "PE-SANTANDER",
          "PE-CENCOSUD",
          "PE-ICBC",
          "PE-NACION",
          "PE-C.AREQUIPA",
          "PE-C.CUSCO",
          "PE-C.HUANCAYO",
          "PE-C.MAYNAS",
          "PE-C.METRO",
          "PE-C.ICA",
          "PE-C.SULLA",
          "PE-C.TACNA",
          "PE-C.TRUJI",
          "PE-FALABELLA",
          "PE-C.ANDES",
          "PE-MIBANCO",
          "PE-C.PIURA",
          "PE-RIPLEY",
          "PE-F.EFECTIVA",
          "PE-YAPE",
          "PE-F.COMPARTAMOS",
          "PE-ALFIN",
          "PE-PLIN",
          "PE-C.ABACO",
          "PE-LIGO",
          "PE-F.CONFIANZA",
          "PE-PREX",
          "PE-T.OH",
          "PE-CREDISCOTIA",
          "PE-DALE"
        ]
      }
    }
  }
}
